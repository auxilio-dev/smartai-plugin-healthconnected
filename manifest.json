{
    "manifest_version": 3,
    "name": "SmartAI HealthConnected Plugin",
    "version": "1.0",
    "description": "Plugin voor het uitlezen van HealthConnected triage.",
    "icons": {
        "16": "icon.png",
        "32": "icon.png",
        "48": "icon.png"
    },
    "permissions": [
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "https://auxilio.app.n8n.cloud/*",
        "https://*.healthconnected.nl/*"
    ],
    "action": {
        "default_popup": "index.html",
        "default_icon": "icon.png"
    },
    "content_scripts": [
        {
            "matches": [
                "https://*.healthconnected.nl/*"
            ],
            "js": [
                "config.js",
                "content.js"
            ],
            "run_at": "document_end",
            "all_frames": true
        },
        {
            "matches": [
                "https://*.healthconnected.nl/*"
            ],
            "js": [
                "phone-reader.js"
            ],
            "run_at": "document_end",
            "world": "MAIN",
            "all_frames": false
        }
    ]
}